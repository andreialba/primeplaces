# GOOGLE_MAPS_API_KEY: Server-only key used for Places, Geocoding, photos, and server-rendered static maps.
# Get one from Google Cloud Console.
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# GEMINI_API_KEY: Server-only key for AI summaries and optional AI features.
# Get one from Google Cloud Console.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins (optional, defaults to localhost).
# Example for production: ALLOWED_ORIGINS="https://yourdomain.com"
# ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
